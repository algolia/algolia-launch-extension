{
  "name": "algolia-insights-extension",
  "version": "3.2.1",
  "author": {
    "name": "Algolia",
    "url": "https://www.algolia.com/"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "turbine",
    "extension",
    "radar"
  ],
  "scripts": {
    "build": "rm -rf dist && webpack --mode production",
    "build:watch": "webpack --mode development --watch",
    "sandbox": "concurrently -k -n webpack,sandbox -c \"bgBlue,bgMagenta\" \"npm run build:watch\" \"reactor-sandbox\"",
    "package": "npm i && npm run build && npx @adobe/reactor-packager",
    "prepack": "npm test && npm run build",
    "lint": "eslint 'src/**'",
    "format": "pretty-quick",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged && lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*.js": [
      "npm run lint -- --fix"
    ]
  },
  "devDependencies": {
    "@adobe/react-spectrum": "^3.47.7",
    "@adobe/reactor-document": "^1.0.0",
    "@adobe/reactor-sandbox": "^14.0.0",
    "@adobe/reactor-window": "^1.0.0",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/runtime": "^7.29.10",
    "@spectrum-icons/illustrations": "^3.7.2",
    "@spectrum-icons/workflow": "^4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^9.2.1",
    "babel-polyfill": "^6.26.0",
    "camelcase": "^6.3.0",
    "capitalize": "^2.0.4",
    "concurrently": "^7.6.0",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^4.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^5.11.1",
    "file-loader": "^6.2.0",
    "fs-extra": "^11.4.1",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^8.0.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-runner-eslint": "^2.3.0",
    "lint-staged": "^17.6.0",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.3.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "style-loader": "^3.3.4",
    "stylus": "^0.59.0",
    "stylus-loader": "^7.1.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4",
    "webpack-shell-plugin": "^0.5.0",
    "yargs": "^17.7.3"
  },
  "overrides": {
    "jshint": {
      "lodash": "^4.18.1",
      "minimatch": "^4.2.6"
    }
  }
}
